# Скопируйте в .env: copy .env.example .env

# URL backend API (без завершающего слэша).
# Пустое значение — запросы через proxy Vite (/api -> backend), без CORS в dev.
VITE_API_URL=http://localhost:5136

# Название приложения (заголовок вкладки)
VITE_APP_TITLE=Accountent

# Часовой пояс для отображения дат
VITE_TIMEZONE=Asia/Krasnoyarsk
