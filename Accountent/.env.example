# Скопируйте в .env и задайте свои значения:
#   copy .env.example .env

# === ASP.NET Core ===
ASPNETCORE_ENVIRONMENT=Development
ASPNETCORE_URLS=http://localhost:5136

# Разрешённые origin для SPA (Vite dev по умолчанию)
Cors__Origins=http://localhost:5173;http://127.0.0.1:5173

# === PostgreSQL ===
# Сервер должен быть запущен (служба Windows или: docker compose up -d postgres)
POSTGRES_HOST=localhost
POSTGRES_PORT=5432
POSTGRES_DB=accountent
POSTGRES_USER=postgres
POSTGRES_PASSWORD=change_me

# Backend собирает ConnectionStrings:DefaultConnection из POSTGRES_* автоматически.
# Для Docker API в compose строка задаётся отдельно (Host=postgres).

# === JWT ===
# Минимум 32 символа для HMAC-SHA256
Jwt__Secret=change_me_minimum_32_characters_long_secret_key
Jwt__Issuer=Accountent
Jwt__Audience=Accountent
Jwt__AccessTokenMinutes=60
Jwt__RefreshTokenDays=7

# === Docker Compose (полный стек: postgres + api + frontend) ===
API_PORT=8080
FRONTEND_PORT=8081
# Origin SPA для CORS API (должен совпадать с URL в браузере)
CORS_ORIGINS=http://localhost:8081;http://127.0.0.1:8081
VITE_APP_TITLE=Accountent
VITE_TIMEZONE=Asia/Krasnoyarsk
